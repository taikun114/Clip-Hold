    "Buy Me a Coffeeで、緑茶一杯分の金額からサポートしていただけます。" : {
      "comment" : "開発者をサポートセクションの、Buy Me a Coffeeで寄付できるボタンのところに表示されるテキスト。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können mich bei Buy Me a Coffee mit dem Preis einer Tasse grünen Tees unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can support me at Buy Me a Coffee from the price of a cup of green tea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede apoyarme en Buy Me a Coffee desde el precio de una taza de té verde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez me soutenir sur Buy Me a Coffee pour le prix d'une tasse de thé vert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy Me a Coffeeで、緑茶一杯分の金額からサポートしていただけます。"
          }
        }
      }
    },
    "Buy Me a Coffeeのページを開いてもよろしいですか？" : {
      "comment" : "開発者をサポートセクションの、Buy Me a Coffeeで寄付ボタンをクリックしたときに表示されるアラートメッセージ。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie die Buy Me a Coffee-Seite wirklich öffnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to open the Buy Me a Coffee page?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que quiere abrir la página de Buy Me a Coffee?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment ouvrir la page Buy Me a Coffee ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy Me a Coffeeのページを開いてもよろしいですか？"
          }
        }
      }
    },
    "Buy Me a Coffeeページへのリンクを開きます。" : {
      "comment" : "開発者をサポートセクションの、Buy Me a Coffeeで寄付ボタンのツールチップに表示されるテキスト。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link zur Buy Me a Coffee-Seite öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open link to the Buy Me a Coffee page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir enlace a la página de Buy Me a Coffee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir le lien vers la page Buy Me a Coffee."
