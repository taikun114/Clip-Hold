    "新規プリセットの作成" : {
      "comment" : "プリセットインポート画面で新たなプリセットを追加する画面に表示されるテキスト。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Preset erstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a New Preset"
          }
        },
        "es" : {
          "stringUnit" : {
