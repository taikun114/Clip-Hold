      }
    },
    "履歴の保存数に合わせる" : {
      "comment" : "一般設定の「履歴の最大表示する」オプションの選択肢の1つ、コピー履歴設定の「履歴の最大保存数」で無制限以外に設定されている場合、保存数で設定された値と同じ数が表示されるように設定するオプション名。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherten Verlauf abgleichen"
          }
        },
        "en" : {
          "stringUnit" : {
