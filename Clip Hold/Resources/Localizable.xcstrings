            "state" : "translated",
            "value" : "Choisissez l'opération pour « %1$@ ». %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\"の操作を選択してください。%2$@"
          }
        }
      }
    },
    "「%@」" : {
