          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Voulez-vous vraiment supprimer « %1$@ » ? Cela supprimera également %2$lld phrase standard incluse dans ce préréglage. Cette action est irréversible."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Voulez-vous vraiment supprimer « %1$@ » ? Cela supprimera également %2$lld phrases standard incluses dans ce préréglage. Cette action est irréversible."
