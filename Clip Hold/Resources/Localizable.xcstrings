        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cambie la aplicación filtrada cuando enfoque la ventana de Clip Hold (como la ventana de Historial) mientras el filtrado “Automático” de la aplicación esté activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne changez pas d'application filtrée lorsque vous activez la fenêtre Clip Hold (comme la fenêtre d'historique) alors que le filtrage « Automatique » de l'application est actif."
          }
        },
        "ja" : {
