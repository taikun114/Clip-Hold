        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\"の操作を選択してください。%2$@"
          }
        }
      }
    },
    "「%@」" : {
      "comment" : "ショートカット設定でそのショートカットに割り当てられている定型文の名前が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
