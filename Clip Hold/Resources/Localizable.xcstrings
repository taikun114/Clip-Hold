          }
        }
      }
    },
    "履歴の最大保存数" : {
      "comment" : "コピー履歴をこのアプリ(Clip Hold)に保存する最大数を設定するオプション名。ユーザが数字を選択できる。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl der Verlaufsspeicherungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum Number of History Saves"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de guardados de historial"
          }
        },
        "fr" : {
          "stringUnit" : {
