      "shouldTranslate" : false
    },
    "\"%@\"の操作を選択してください。%@" : {
      "comment" : "複数のプリセットをインポートした際に一つ一つ解決するときのタイトルメッセージ。1つ目にはプリセット名、2つ目には個数の進捗が「(現在のプリセット数/すべてのプリセット数)」の形式で表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Operation für „%1$@“. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the operation for “%1$@”. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija la operación para “%1$@”. %2$@"
          }
        },
        "fr" : {
