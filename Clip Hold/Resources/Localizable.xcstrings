                "stringUnit" : {
                  "state" : "translated",
                  "value" : " - %lld文字"
                }
              }
            }
          }
        }
      }
    },
    "-" : {
      "shouldTranslate" : false
    },
    "\"%@\"の操作を選択してください。%@" : {
      "comment" : "複数のプリセットをインポートした際に一つ一つ解決するときのタイトルメッセージ。1つ目にはプリセット名、2つ目には個数の進捗が「(現在のプリセット数/すべてのプリセット数)」の形式で表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Operation für „%1$@“. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the operation for “%1$@”. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\"の操作を選択してください。%2$@"
          }
        }
      }
    },
    "「%@」" : {
      "comment" : "ショートカット設定でそのショートカットに割り当てられている定型文の名前が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」"
          }
        }
      }
    },
    "「%@」からのすべての履歴を削除してもよろしいですか？%lld個の履歴が削除されます。この操作は元に戻せません。" : {
      "comment" : "特定のアプリからコピーされたすべての履歴を削除しようとしたときのアラートメッセージです。アプリ名と、そのアプリからコピーされた履歴の個数が表示されます。",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Möchten Sie den gesamten Verlauf von „%1$@“ wirklich löschen? %2$lld Element wird gelöscht. Dies kann nicht rückgängig gemacht werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Möchten Sie den gesamten Verlauf von „%1$@“ wirklich löschen? %2$lld Elemente werden gelöscht. Dies kann nicht rückgängig gemacht werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Are you sure you want to delete all history from “%1$@”? %2$lld item will be deleted. This cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Are you sure you want to delete all history from “%1$@”? %2$lld items will be deleted. This cannot be undone."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "「%1$@」からのすべての履歴を削除してもよろしいですか？%2$lld個の履歴が削除されます。この操作は元に戻せません。"
                }
              }
            }
          }
        }
      }
    },
    "「%@」に切り替わりました。" : {
      "comment" : "ショートカットキーで定型文プリセットを切り替えたときに表示される通知メッセージです。プリセット名が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu „%@“ gewechselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched to “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に切り替わりました。"
          }
        }
      }
    },
    "「%@」のインポートの競合 (%lld/%lld)%@" : {
      "comment" : "複数のプリセットを1つずつ解決しようとしている時に表示されるタイトルです。プリセット名、現在処理しているプリセットの順番、そのプリセットに含まれる定型文の数、現在処理しているプリセットの順番と累計プリセット数のまとまったテキストが表示されます。arg3は「インポートの競合」テキストの複数形と単数形を分けるための引数です。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg3@ für „%1$@“ (%2$lld/%3$lld)%4$@"
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Importkonflikt"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Importkonflikte"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg3@ for “%1$@” (%2$lld/%3$lld)%4$@"
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Import Conflict"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Import Conflicts"
                    }
                  }
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の%#@arg3@ (%2$lld/%3$lld)%4$@"
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "インポートの競合"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "「%@」は別のプリセット「%@」にすでに割り当てられています。このアプリを割り当てると、「%@」から割り当てが解除されます。アプリを割り当ててもよろしいですか？" : {
      "comment" : "既に別のプリセットに割り当てられたアプリを、さらに別のプリセットに割り当てようとしたときに表示される警告メッセージです。割り当てようとしているアプリ名、既にそのアプリが割り当てられているプリセット名、このまま割り当てた時に既に割り当てられていた割り当てが解除されるプリセット名（既にそのアプリが割り当てられているプリセット名と同じ）が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist bereits dem Preset „%2$@“ zugewiesen. Wenn Sie diese App zuweisen, wird die Zuweisung von „%3$@“ aufgehoben. Möchten Sie diese App wirklich zuweisen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is already assigned to another preset “%2$@”. Assigning this app will unassign it from “%3$@”. Are you sure you want to assign this app?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は別のプリセット「%2$@」にすでに割り当てられています。このアプリを割り当てると、「%3$@」から割り当てが解除されます。アプリを割り当ててもよろしいですか？"
          }
        }
      }
    },
    "「%@」を本当に削除しますか？" : {
      "comment" : "履歴と定型文ウィンドウ、定型文設定からその履歴または定型文を削除しようとしている際に表示されるアラートメッセージ。定型文のタイトルまたは履歴本文が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie „%@“ wirklich löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を本当に削除しますか？"
          }
        }
      }
    },
    "「%@」を本当に削除しますか？このプリセットに含まれる%lld個の定型文も削除されます。この操作は元に戻せません。" : {
      "comment" : "定型文プリセットを削除しようとしている場合に表示されるアラートメッセージ。定型文の数によって「定型文」の単語が単数形または複数形に切り替えられます。プリセット名が表示されます。",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Möchten Sie „%1$@“ wirklich löschen? Dies löscht auch %2$lld Standardphrase, die in diesem Preset enthalten ist. Dies kann nicht rückgängig gemacht werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Möchten Sie „%1$@“ wirklich löschen? Dies löscht auch %2$lld Standardphrasen, die in diesem Preset enthalten sind. Dies kann nicht rückgängig gemacht werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Are you sure you want to delete “%1$@”? This will also delete %2$lld standard phrase included in this preset. This cannot be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Are you sure you want to delete “%1$@”? This will also delete %2$lld standard phrases included in this preset. This cannot be undone."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "「%1$@」を本当に削除しますか？このプリセットに含まれる%2$lld個の定型文も削除されます。この操作は元に戻せません。"
                }
              }
            }
          }
        }
      }
    },
    "「%@」を本当に削除しますか？履歴からファイルが削除され、このファイルに関連する他の履歴も削除されます。" : {
      "comment" : "履歴ウィンドウから、過去にコピーされたファイルを削除しようとしている際に表示されるアラートメッセージ。ファイル名（履歴名）が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie „%@“ wirklich löschen? Die Datei wird aus dem Verlauf entfernt und alle anderen damit verbundenen Verlaufseinträge werden ebenfalls gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete “%@”? The file will be removed from the history and any other history items associated with this file will also be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を本当に削除しますか？履歴からファイルが削除され、このファイルに関連する他の履歴も削除されます。"
          }
        }
      }
    },
    "「%@」を除外するアプリに追加しますか？除外するアプリは「プライバシー」設定から変更することができます。" : {
      "comment" : "履歴ウィンドウで、そのコピー履歴がコピーされたアプリを除外するアプリリストに追加しようとした場合に表示されるアラートメッセージ。除外しようとしているアプリ名が示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie „%@“ zu den auszuschließenden Apps hinzufügen? Sie können die auszuschließenden Apps in den „Datenschutz“-Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to add “%@” to the Apps to Exclude? You can change the Apps to Exclude in the “Privacy” settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を除外するアプリに追加しますか？除外するアプリは「プライバシー」設定から変更することができます。"
          }
        }
      }
    },
    "%@を超えるファイルがコピーされました。履歴に保存してもよろしいですか？" : {
      "comment" : "「コピーアラートを表示する容量」の設定値よりも大きいファイルがコピーされたときに表示されるアラートメッセージ。設定された容量が表示されます。",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei, die größer als %@ ist, wurde kopiert. Möchten Sie sie im Verlauf speichern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file has been copied that is larger than %@. Are you sure you want to save it in the history?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を超えるファイルがコピーされました。履歴に保存してもよろしいですか？"
          }
        }
      }
    },
    "%@定型文をコピーする" : {
      "comment" : "特定のインデックスの定型文をコピーするショートカット設定の項目名。「1番目の」や「2番目の」のような序数詞が表示されます。",
